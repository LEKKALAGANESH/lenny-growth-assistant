# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Environment (development, test, production)
ENVIRONMENT=development

# API Settings
API_V1_PREFIX=/api
PROJECT_NAME="The Lenny Growth Assistant"

# Database Configuration
# In development/offline mode, if PostgreSQL is unreachable, system automatically
# falls back to SQLite at data/storage/app_fallback.db
DATABASE_URL=postgresql://lenny_user:lenny_password@localhost:5432/lenny_growth_db

# LLM Provider Configuration
# Options: "ollama" (Local - Default for Offline Demo), "anthropic", "openai", "mock"
DEFAULT_LLM_PROVIDER=ollama

# Local Ollama Configuration (Zero-cost offline inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM API Keys (Optional - for Anthropic Claude & OpenAI GPT-4o)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# RAG & Knowledge Base Configuration
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
SIMILARITY_TOP_K=5
BM25_TOP_K=5
RRF_K=60

# Next.js Frontend (Exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
